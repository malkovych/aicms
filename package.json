{
  "name": "aicms",
  "version": "0.3.0",
  "description": "CMS for AI agents: one schema generates REST, MCP tools, admin and types",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malkovych/aicms.git"
  },
  "homepage": "https://malkovych.github.io/aicms/",
  "private": true,
  "type": "module",
  "bin": {
    "aicms": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./modules": {
      "types": "./dist/modules/index.d.ts",
      "default": "./dist/modules/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -b packages/client packages/next packages/astro packages/sveltekit packages/nuxt && npm run build -w @aicms/studio",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -b packages/client packages/next packages/astro packages/sveltekit packages/nuxt && tsc -p studio --noEmit",
    "test": "node --conditions=source --experimental-strip-types --disable-warning=ExperimentalWarning --test --test-timeout=30000 'test/*.test.ts'",
    "test:python": "cd sdk/python && python3 -m unittest discover -s tests -v",
    "studio": "npm run dev -w @aicms/studio",
    "example": "npm run build && cd examples/blog && node ../../dist/cli.js dev",
    "test:pg": "AICMS_TEST_DB=pglite node --conditions=source --experimental-strip-types --disable-warning=ExperimentalWarning --test --test-concurrency=2 --test-timeout=120000 'test/*.test.ts'"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "graphql": "^17.1.0",
    "hono": "^4.13.19",
    "jiti": "^2.7.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@electric-sql/pglite-socket": "^0.2.20",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "packages/client",
    "packages/next",
    "packages/astro",
    "packages/sveltekit",
    "packages/nuxt",
    "studio"
  ]
}
