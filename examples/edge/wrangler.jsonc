{
  "name": "aicms-edge",
  "main": "worker.ts",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // wrangler d1 create aicms → put its id here
  "d1_databases": [{ "binding": "DB", "database_name": "aicms", "database_id": "00000000-0000-0000-0000-000000000000" }],
  // wrangler r2 bucket create aicms-media
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "aicms-media" }],
  // Studio, prebuilt inside the aicms package
  "assets": { "directory": "./node_modules/aicms/dist/studio", "binding": "ASSETS", "run_worker_first": true }
}
